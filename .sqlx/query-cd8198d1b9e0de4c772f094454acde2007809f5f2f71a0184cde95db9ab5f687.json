  "query": "SELECT p.id, p.chief_complaint, p.display_label, p.created_at\n               FROM shift_patients sp\n               JOIN patients p ON p.id = sp.patient_id\n              WHERE sp.shift_id = $1 AND p.org_id = $2\n              ORDER BY sp.position ASC",
