# Set APP_ENV=dev in the launching shell too; .env cannot select the environment.
APP_ENV=dev
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://postgres:dev@localhost:5433/ernote
DB_MAX_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT_SECS=5
DB_CONNECT_TIMEOUT_SECS=10
# Cloud requires an absolute, packaged, reviewed RDS CA bundle path:
# DB_SSL_ROOT_CERT=/etc/ssl/certs/rds-global-bundle.pem
MAX_AUDIO_BYTES=16777216

AUTH_MODE=dev
DEV_JWKS_PATH=dev/keys/jwks.json

# Local S3/SQS protocol clones. Omit both endpoint overrides in AWS/ECS.
S3_ENDPOINT_URL=http://localhost:9000
SQS_ENDPOINT_URL=http://localhost:9324
AUDIO_BUCKET=er-audio-dev
STT_QUEUE=stt-jobs
# Local emulator Region. Staging is us-east-2; set cloud AWS_REGION and COGNITO_REGION there.
# Do not source this dev file in the shell used for AWS SSO setup.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=devdevdev

# Empty means the later worker uses its mock provider.
DEEPGRAM_API_KEY=
ANTHROPIC_KEY=

# Step 7 AI routing. Direct uses ANTHROPIC_KEY; Bedrock uses the AWS task role.
TRANSPORT=direct
SUMMARY_MODEL=sonnet
MDM_MODEL=sonnet
# Bedrock route, only with TRANSPORT=bedrock. Required in staging and prod; staging
# uses the US geographic profile. Leave unset for direct mode.
# BEDROCK_SUMMARY_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_MDM_MODEL_ID=us.anthropic.claude-sonnet-4-6
