# Copy to terraform.tfvars and fill in verified values. terraform.tfvars is gitignored.
# Bucket and key values come from `terraform -chdir=infra/bootstrap output`.

aws_account_id          = "000000000000"
aws_region              = "us-east-2"
project                 = "ernote"
deploy_artifacts_bucket = "ernote-deploy-000000000000-us-east-2"
deploy_kms_key_arn      = "arn:aws:kms:us-east-2:000000000000:key/00000000-0000-0000-0000-000000000000"

# Recorded in the manifest so a release traces back to the run that produced it.
# CI sets this to the commit SHA.
generated_by = "local"

# Pin the pair selected by the first reviewed plan; these are example AZ names.
# No client CIDRs until S8 has installed TLS and WAF. No paid interface endpoints.
network = {
  availability_zones = ["us-east-2a", "us-east-2b"]
  vpc_cidr           = "10.40.0.0/16"
  nat_per_az         = false
}

# S5 durable resources. Everything here has a synthetic-staging default; these are the
# values worth stating out loud in a review. Check the instance class and gp3 storage
# combination is offered in the region before the first apply, and pin an exact
# PostgreSQL minor below was verified orderable in us-east-2 on 2026-10-14.
# Recheck availability before applying this example later.
data = {
  postgres_version                        = "16.15"
  db_instance_class                       = "db.t4g.small"
  db_allocated_storage                    = 50
  db_max_allocated_storage                = 100
  db_multi_az                             = false
  db_backup_retention_days                = 7
  audio_retention_days                    = 7
  audio_noncurrent_version_retention_days = 7
  audio_abort_incomplete_multipart_days   = 7
  db_backup_window                        = "07:00-07:30"
  db_maintenance_window                   = "sun:08:00-sun:09:00"
  queue_visibility_timeout_seconds        = 300
  queue_receive_wait_seconds              = 20
  queue_max_receive_count                 = 3
  queue_retention_days                    = 4
  dlq_retention_days                      = 14
}
