# Copy to terraform.tfvars and fill in verified values. terraform.tfvars is gitignored.
# Bucket and key values come from `terraform -chdir=infra/bootstrap output`.

aws_account_id          = "000000000000"
aws_region              = "us-east-2"
project                 = "ernote"
deploy_artifacts_bucket = "ernote-deploy-000000000000-us-east-2"
deploy_kms_key_arn      = "arn:aws:kms:us-east-2:000000000000:key/00000000-0000-0000-0000-000000000000"

# Recorded in the manifest so a release traces back to the run that produced it.
# CI sets this to the commit SHA.
generated_by = "local"

# Production is authored but unprovisioned. Flipping this to true is a reviewed
# decision gated on the production contract and the pre-PHI conditions in S0.
enabled = false

# Pin the pair selected by the first reviewed plan; these are example AZ names.
# No client CIDRs until S8 has installed TLS and WAF. No paid interface endpoints.
network = {
  availability_zones = ["us-east-2a", "us-east-2b"]
  vpc_cidr           = "10.50.0.0/16"
  nat_per_az         = false
}

# S5 durable resources. Enabling this root without stating both of the values below
# fails the plan on purpose: they decide how much clinical data an incident can lose,
# and staging's synthetic numbers are not an answer for production. Audio retention and
# any legal-hold requirement need the same explicit review before real patient data.
data = {
  db_multi_az              = true
  db_backup_retention_days = 35
  db_instance_class        = "db.t4g.small" # Size from measured production load.
}
