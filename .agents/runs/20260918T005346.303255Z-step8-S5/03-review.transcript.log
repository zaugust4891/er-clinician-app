diff --git a/scripts/tf-network-check.sh b/scripts/tf-network-check.sh
index e0cb019..25696b0 100755
--- a/scripts/tf-network-check.sh
+++ b/scripts/tf-network-check.sh
@@ -1,37 +1,39 @@
 #!/usr/bin/env bash
 # S4 security/placement gates. All providers are mocked: no AWS credentials or
 # cloud mutations. Copy only Terraform source/tests and committed provider locks,
 # excluding local tfvars, backend configuration, and state.
 set -euo pipefail
 repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 work="$(mktemp -d)"
 trap 'rm -rf "${work}"' EXIT
 
-for relative in modules/network modules/manifest envs/staging/foundation envs/prod/foundation; do
+# modules/data is copied but not tested here: the foundation roots call it, so their
+# configuration cannot be initialised without it. Its own gate is scripts/tf-data-check.sh.
+for relative in modules/network modules/manifest modules/data envs/staging/foundation envs/prod/foundation; do
   source_dir="${repo_root}/infra/${relative}"
   test_dir="${work}/infra/${relative}"
   mkdir -p "${test_dir}"
   cp "${source_dir}"/*.tf "${test_dir}/"
   if [[ -d "${source_dir}/tests" ]]; then
     cp -R "${source_dir}/tests" "${test_dir}/"
   fi
   if [[ -f "${source_dir}/.terraform.lock.hcl" ]]; then
     cp "${source_dir}/.terraform.lock.hcl" "${test_dir}/"
   fi
 done
 cp "${repo_root}/infra/envs/staging/foundation/.terraform.lock.hcl" "${work}/infra/modules/network/"
 
 for relative in modules/network envs/staging/foundation envs/prod/foundation; do
   test_dir="${work}/infra/${relative}"
   # A local filesystem provider mirror is optional; the lock still verifies it.
   init_args=()
   if [[ -n "${TF_NETWORK_PLUGIN_DIR:-}" ]]; then
     init_args+=("-plugin-dir=${TF_NETWORK_PLUGIN_DIR}")
   fi
   terraform -chdir="${test_dir}" init -backend=false -input=false -lockfile=readonly -no-color "${init_args[@]}" >"${work}/init.log" 2>&1 || {
     cat "${work}/init.log"
     exit 1
   }
   terraform -chdir="${test_dir}" validate -no-color
   terraform -chdir="${test_dir}" test -no-color
 done
     1	# Step 8 S5 data verification
     2	
     3	Written 2026-09-17. **Authored and tested offline; not applied to AWS.** No database,
     4	bucket, queue or key exists in any account. The live checks below need the applied
     5	foundation, S6's roles and database logins, and an approved diagnostic image; their
     6	status is pending. Staging is synthetic-only — this record does not authorise patient
     7	audio, transcripts, or notes.
     8	
     9	## Default choices
    10	
    11	| Decision | Staging value | Why, and what it costs |
    12	|---|---|---|
    13	| Engine | PostgreSQL 16, bare major version | RDS selects a currently supported minor at creation; pin an exact minor once `describe-db-engine-versions` confirms it for the region |
    14	| Class and storage | `db.t4g.small`, single-AZ, 50 GiB gp3, autoscaling capped at 100 GiB | The plan's starting point. Single-AZ is a cost choice: an AZ failure is an outage and a restore, not a failover |
    15	| Automated backups | 7 days, 07:00–07:30 UTC, `delete_automated_backups = false` | S0's synthetic default. Zero is rejected by the module — an unavailable backup is already a Step 8 failure |
    16	| Maintenance | Sunday 08:00–09:00 UTC, minor upgrades allowed | Does not overlap the backup window |
    17	| Transport | `rds.force_ssl = 1`, client `sslmode=verify-full` | Server refusal plus client CA and hostname verification. Either alone is insufficient |
    18	| Audio | 7-day current expiry, 7-day noncurrent expiry, 7-day multipart abort, no transitions | S0's synthetic default. The worker cannot transcribe an archived object, so nothing is tiered |
    19	| Queue | Standard, 300 s visibility, 20 s long poll, `maxReceiveCount = 3`, 4-day retention | Visibility matches the worker's lease exactly (270 s job budget + 10 s terminal work) |
    20	| Dead-letter queue | `<queue>-dlq`, 14-day retention, single permitted source | The name is what `Config::stt_dlq` derives; failures outlive the live work |
    21	| Encryption | One customer-managed key for RDS, S3 and SQS, annual rotation, 30-day deletion window | Separate from the bootstrap state key. Per-tenant keys are not justified by any current contract |
    22	| Master credential | RDS-managed in Secrets Manager under the data key | No password in Terraform state. A bootstrap credential only; no running service receives it |
    23	
    24	### The 7-versus-35-day question, resolved
    25	
    26	The older plan carried both numbers. **Synthetic staging uses 7 days**, matching S0's
    27	adopted retention. **Production sets its own**, from production recovery objectives: the
    28	production root refuses to plan until `db_multi_az` and `db_backup_retention_days` are
    29	stated explicitly, so staging's convenience cannot become a production default by
    30	inheritance. A retention period longer than 30 days cannot be fully covered by the KMS
    31	deletion window AWS allows; record that gap when choosing a longer production value.
    32	
    33	Backups, S3 historical versions, transcripts in `audio_chunks`, raw `TranscriptReady`
    34	events, snapshots and exported notes are **separate copies**. Expiring audio removes one
    35	of them. A deletion or legal-hold workflow has to name all of them, and does not exist yet.
    36	
    37	## Cost assumptions
    38	
    39	These are the on-demand rates used in the earlier cost model, carried forward for
    40	`us-east-2` at 730 hours per month. **They were not re-fetched from AWS pricing pages for
    41	this change**; confirm each line before provisioning, and treat the result as an estimate
    42	rather than billing evidence.
    43	
    44	| Component | Assumption | Estimated monthly idle cost |
    45	|---|---|---|
    46	| `db.t4g.small`, single-AZ PostgreSQL | 730 × ~$0.032/hour | ~$23 |
    47	| 50 GiB gp3 database storage | 50 × ~$0.115/GB-month | ~$6 |
    48	| Automated backup storage | Free up to 100% of allocated storage; synthetic data is far below that | ~$0 |
    49	| Customer-managed KMS key | $1/key-month plus per-request charges | ~$1 |
    50	| Audio objects and requests | Days of synthetic audio at ~$0.023/GB-month | <$1 |
    51	| SQS | Well inside the 1M-request free allowance | ~$0 |
    52	| **S5 subtotal** | | **~$31** |
    53	| S4 network (already recorded) | NAT + its IPv4 | $36.50 |
    54	
    55	Multi-AZ roughly doubles the instance line. So does an idle second environment. The two
    56	subtotals together already exceed the reported $50 testing budget before ECS, the ALB,
    57	logs, WAF, Deepgram or Bedrock; the full-stack estimate and the budget decision remain
    58	open in the [deployment contract](deployment-contract.md).
    59	[RDS pricing](https://aws.amazon.com/rds/postgresql/pricing/),
    60	[KMS pricing](https://aws.amazon.com/kms/pricing/), [S3 pricing](https://aws.amazon.com/s3/pricing/).
    61	
    62	## Local gates
    63	
    64	```bash
    65	terraform fmt -check -recursive infra/
    66	./scripts/tf-data-check.sh
    67	```
    68	
    69	The script copies only Terraform source, tests and root lockfiles into a temporary
    70	directory, then runs mocked-provider tests for `infra/modules/data/` and both foundation
    71	roots. It excludes operator tfvars, state and backend settings, needs no AWS credentials,
    72	and creates nothing. Set `TF_DATA_PLUGIN_DIR` to a provider filesystem mirror for offline
    73	installation (`scripts/tf-network-check.sh` uses `TF_NETWORK_PLUGIN_DIR` the same way).
    74	
    75	Verified locally on 2026-09-17 with Terraform 1.10.4 and AWS provider 6.64.0:
    76	**22 test runs passed** — 12 in the module (defaults, explicit retention and operator
    77	grants, and ten rejected inputs), 4 in the staging foundation, 6 in production
    78	(disabled, both missing-decision refusals, and explicitly enabled). `tf-network-check.sh`
    79	now runs 23 (its 13 module runs plus the foundation roots' network *and* data files, up
    80	from 17), `tf-manifest-guards.sh` runs its 7 cases, and all five roots validate. `cargo test -p er-server --test config_gate` passes, including the new
    81	`deployed_queue_names_and_lease_match_the_provisioned_pair`, which pins the queue naming
    82	and 300-second lease this module mirrors.
    83	
    84	## Inspect the applied resources
    85	
    86	Follow the [staging runbook](staging-deploy.md) for SSO and backend setup. After the
    87	complete foundation applies, collect non-secret configuration only.
    88	
    89	```bash
    90	terraform -chdir=infra/envs/staging/foundation output -json data
    91	# Set DATA_DB_ID, DATA_PG_GROUP, DATA_BUCKET, DATA_QUEUE_URL, DATA_DLQ_URL and
    92	# DATA_KEY_ARN from its db_identifier, db_parameter_group_name, audio_bucket_name,
    93	# stt_queue_url, stt_dlq_url and kms_key_arn fields.
    94	
    95	aws rds describe-db-instances --db-instance-identifier "$DATA_DB_ID" \
    96	  --query 'DBInstances[].{public:PubliclyAccessible,encrypted:StorageEncrypted,key:KmsKeyId,
    97	    multiAz:MultiAZ,backupDays:BackupRetentionPeriod,window:PreferredBackupWindow,
    98	    protection:DeletionProtection,ca:CACertificateIdentifier,subnets:DBSubnetGroup.DBSubnetGroupName,
    99	    groups:VpcSecurityGroups[].VpcSecurityGroupId,latestRestorable:LatestRestorableTime}'
   100	
   101	aws rds describe-db-parameters --db-parameter-group-name "${DATA_DB_ID%-pg}-pg-postgres16" \
   102	  --query 'Parameters[?ParameterName==`rds.force_ssl`].[ParameterValue,ApplyType]'
   103	
   104	aws s3api get-public-access-block --bucket "$DATA_BUCKET"
   105	aws s3api get-bucket-versioning --bucket "$DATA_BUCKET"
   106	aws s3api get-bucket-encryption --bucket "$DATA_BUCKET"
   107	aws s3api get-bucket-lifecycle-configuration --bucket "$DATA_BUCKET"
   108	aws s3api get-bucket-policy --bucket "$DATA_BUCKET" --query Policy --output text
   109	
   110	aws sqs get-queue-attributes --queue-url "$DATA_QUEUE_URL" --attribute-names All \
   111	  --query 'Attributes.{visibility:VisibilityTimeout,wait:ReceiveMessageWaitTimeSeconds,
   112	    retention:MessageRetentionPeriod,redrive:RedrivePolicy,key:KmsMasterKeyId}'
   113	aws sqs get-queue-attributes --queue-url "$DATA_DLQ_URL" --attribute-names All \
   114	  --query 'Attributes.{retention:MessageRetentionPeriod,allow:RedriveAllowPolicy,key:KmsMasterKeyId}'
   115	
   116	aws kms describe-key --key-id "$DATA_KEY_ARN" --query 'KeyMetadata.{state:KeyState,manager:KeyManager}'
   117	aws kms get-key-rotation-status --key-id "$DATA_KEY_ARN"
   118	```
   119	
   120	Expected: `PubliclyAccessible = false`, encryption on with the data key, backups
   121	non-zero with the chosen window, deletion protection on, `rds.force_ssl = 1`, all four
   122	public-access blocks true, versioning `Enabled`, SSE-KMS with the data key, three
   123	lifecycle rules with **no** transition, visibility 300, wait 20, `maxReceiveCount = 3`,
   124	the DLQ permitting exactly one source queue, both queues KMS-encrypted, and key rotation
   125	enabled. Confirm `LatestRestorableTime` advances once the first backup exists; a
   126	`LatestRestorableTime` that never moves is a Step 8 failure, not a Step 9 one.
   127	
   128	## Prove the upload contract, positively and negatively
   129	
   130	The point of the bucket policy is that a **correctly signed upload with no encryption
   131	headers succeeds** while everything else fails. Test all five with synthetic bytes:
   132	
   133	| Case | Expected |
   134	|---|---|
   135	| Presigned PUT from outside the VPC, `Content-Type` only, no SSE headers | 200; the stored object shows `ServerSideEncryption=aws:kms` and the data key |
   136	| Same URL with `x-amz-server-side-encryption: AES256` | 403 |
   137	| Same URL with a different KMS key id | 403 |
   138	| Unsigned/public `GET` of the stored key, and any `http://` request | 403 |
   139	| Presigned PUT replayed after `expires_in_secs` | 403 |
   140	
   141	```bash
   142	aws s3api head-object --bucket "$DATA_BUCKET" --key "$SYNTHETIC_KEY" \
   143	  --query '{sse:ServerSideEncryption,key:SSEKMSKeyId,bucketKey:BucketKeyEnabled,type:ContentType,len:ContentLength}'
   144	```
   145	
   146	Record the assertion names and status codes. Do not paste presigned URLs, object bodies
   147	or credentials into this file.
   148	
   149	**Known open behavior, not a defect to be hidden:** replaying a still-valid presigned URL
   150	overwrites its key, and the completion handler's `HeadObject` followed by the worker's
   151	unversioned `GetObject` does not pin the approved bytes. Versioning makes that
   152	recoverable, not impossible. Do not describe staging audio as immutable. Closing it
   153	(persisted version/checksum binding, or a tested write-once contract) is Step 9 work and
   154	is required before any PHI.
   155	
   156	## What S6 must still prove
   157	
   158	S5 creates the resources and their resource policies; it grants no identity anything.
   159	These belong to S6's permission probes and are listed here so they are not forgotten:
   160	
   161	- API role: `PutObject`, `GetObject`, `ListBucket` on this bucket, `SendMessage` and
   162	  `GetQueueUrl`, and the KMS `GenerateDataKey`/`Decrypt` that a presigned PUT and an
   163	  encrypted queue message actually require.
   164	- Worker role: `GetObject`, receive/delete/change-visibility, `GetQueueUrl` on both
   165	  queues, `Decrypt` — and **no** audio `PutObject`.
   166	- Neither runtime role may delete the bucket, purge a queue, change retention or
   167	  lifecycle, disable or schedule deletion of the key, modify the database, or read
   168	  backups and snapshots. Probe each of those negatively with the real role.
   169	- Test the KMS grants against a real upload: S3 Bucket Keys change the encryption context
   170	  S3 sends, so an untested `kms:EncryptionContext` condition can pass review and fail in
   171	  production.
   172	
   173	## Evidence
   174	
   175	| Evidence | Status / owner |
   176	|---|---|
   177	| Module, foundation wiring, manifest keys, offline gates | Implemented locally; engineering |
   178	| Verified account, region class/storage availability, pinned engine minor | Pending; operator |
   179	| Applied resource inspection (the commands above) | Pending apply; operator |
   180	| `LatestRestorableTime` observed advancing | Pending first backup; operator |
   181	| Signed upload succeeds without SSE headers; wrong algorithm/key/public/insecure denied | Pending apply and a synthetic client; engineering |
   182	| Object encryption metadata inspected | Pending apply; engineering |
   183	| Runtime roles cannot change these controls | Pending S6; engineering |
   184	| Restore rehearsal | Step 9; engineering |
   185	| Audio version/checksum binding | Step 9 protocol change; engineering |
   186	| Actual RDS/KMS/S3/SQS charges | Pending billing; operator |
     1	# S5 data boundary
     2	
     3	Shared by both foundation roots. Staging provisions this module; production calls it
     4	only with `enabled = true` and only after it has stated its own availability and
     5	retention decisions. No cloud apply has been performed. Run `scripts/tf-data-check.sh`
     6	from the repository root for mocked provider checks.
     7	
     8	## What it creates, and who consumes it
     9	
    10	| Resource | Application use |
    11	|---|---|
    12	| `aws_db_instance.this` (PostgreSQL 16, private, gp3, encrypted) | Every event, snapshot, chunk row, transcript, note and usage record. API, worker and the one-shot migration connect with `sslmode=verify-full` |
    13	| `aws_db_parameter_group.postgres` | `rds.force_ssl = 1`; statement logging pinned off |
    14	| `aws_s3_bucket.audio` | `AUDIO_BUCKET`. The device PUTs chunks with a presigned URL; the worker downloads them once |
    15	| `aws_sqs_queue.jobs` / `aws_sqs_queue.dlq` | `STT_QUEUE` and its derived `<name>-dlq`. `TranscribeChunk` and `GenerateMdm` jobs, and failures after three attempts |
    16	| `aws_kms_key.data` | Encrypts all three: RDS storage and snapshots, audio objects, queue payloads |
    17	
    18	Names are contracts, not labels. The application is given `STT_QUEUE=<name>` and derives
    19	its dead-letter queue as `<name>-dlq` (`Config::stt_dlq`), then resolves both with
    20	`GetQueueUrl`; it never creates anything. `crates/er-server/tests/config_gate.rs`'s
    21	`deployed_queue_names_and_lease_match_the_provisioned_pair` pins that derivation and the
    22	300-second lease this module mirrors.
    23	
    24	## Encryption and the key boundary
    25	
    26	One customer-managed key covers RDS, S3 and SQS. It is separate from the bootstrap
    27	state/artifact key (`alias/<project>-tfstate`), so application data and Terraform state
    28	never share a grant. S6 scopes who may use it; this module only delegates to account IAM.
    29	
    30	**Disabling or scheduling deletion of this key makes the data unrecoverable**, including
    31	snapshots taken while the key was healthy. `kms_deletion_window_days` must cover
    32	`db_backup_retention_days`, up to the 30-day maximum AWS allows — a retention period
    33	longer than 30 days cannot be fully covered, and scheduling deletion then shortens the
    34	recovery horizon below the retention period. Per-tenant keys are deliberately not used;
    35	tenancy is enforced by authenticated repository scoping and server-derived object keys.
    36	
    37	S6 must grant, in both IAM **and** the key policy: `GenerateDataKey` for the API role
    38	(a presigned PUT is signed by the API's credentials, so S3 evaluates *its* permissions
    39	when the device uploads), `Decrypt` for the worker, and the SQS producer/consumer
    40	combination. Test those grants against a real upload: S3 Bucket Keys change the
    41	encryption context S3 sends.
    42	
    43	## Audio: what versioning does and does not promise
    44	
    45	All four public-access blocks are on, ACLs are disabled, SSE-KMS is the bucket default
    46	with bucket keys, and the bucket policy denies plain HTTP, TLS below 1.2, and any upload
    47	that *overrides* the default encryption. The encryption conditions use
    48	`StringNotEqualsIfExists`: the presigned PUT the API mints today sends **no** SSE header,
    49	and rejecting header-less uploads would break every client. Requiring headers instead
    50	means changing `audio_upload_intent` and the device together, in one change.
    51	
    52	Three lifecycle rules run on separate clocks — current objects, superseded versions, and
    53	abandoned multipart uploads. There is no storage-class transition: the worker downloads
    54	pending audio with `GetObject` and has no restore workflow, so an archived object would
    55	fail rather than wait. Expiry is asynchronous; it is not a deletion deadline, and it
    56	removes none of the other copies (transcripts in `audio_chunks`, `TranscriptReady`
    57	events, snapshots, exported notes, RDS backups). No Object Lock is configured: a
    58	compliance-mode retention is an approved legal decision, not a default.
    59	
    60	**The presigned overwrite race is open and must not be described as immutability.** The
    61	same valid URL can be replayed to overwrite its key, and the completion handler's
    62	`HeadObject` followed by the worker's unversioned `GetObject` does not pin the bytes that
    63	were approved. Versioning makes the overwrite *recoverable*, not impossible. Closing it
    64	means persisting a version id or checksum at completion and having the worker read that
    65	version, or a tested write-once contract — a protocol change deferred to Step 9 while
    66	staging is synthetic.
    67	[Presigned upload behavior](https://docs.aws.amazon.com/AmazonS3/latest/userguide/PresignedUrlUploadObject.html).
    68	
    69	`bucket_administration_principal_arns` is empty by default. When set, it adds a deny for
    70	the bucket's own protection settings to every principal outside the list — which must
    71	include the Terraform role that applies this module, because a bucket policy binds every
    72	caller. `aws:PrincipalArn` reports an assumed role's role ARN, not its session ARN.
    73	No `aws:SourceVpce` condition exists anywhere in the policy: the phone and CLI sign
    74	uploads from outside the VPC.
    75	
    76	## Queues
    77	
    78	One standard queue and its DLQ, because one queue is what the code sends to. Visibility
    79	is 300 seconds to match the worker's lease exactly (a 270-second job budget plus 10
    80	seconds of terminal bookkeeping); long polling is 20 seconds; three deliveries then the
    81	DLQ; retention is 4 days on the main queue and 14 on the DLQ, so a failure outlives the
    82	live work that produced it. `redrive_allow_policy` permits exactly one source queue.
    83	Moving messages back is a separate IAM grant — `dlq_operator_principal_arns` mirrors it
    84	in the queue policy when an operator role exists, and is empty until S6 creates one.
    85	
    86	Both queues use SSE-KMS with the data key. Naming a customer-managed key replaces
    87	SQS-managed encryption, and the provider rejects setting both, so `sqs_managed_sse_enabled`
    88	is absent rather than `false`. Message bodies carry opaque identifiers only; no
    89	transcript, name, or provider response appears in a body, attribute, queue name, or
    90	alarm text. [SQS KMS requirements](https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/sqs-key-management.html).
    91	
    92	## Database
    93	
    94	Single-AZ `db.t4g.small` on 50 GiB gp3 with autoscaling capped at 100 GiB, private, with
    95	no public endpoint and no route to NAT or the internet gateway. Verify the class and
    96	storage combination is offered in the region before applying; `postgres_version` defaults
    97	to the bare major so RDS selects a currently supported minor, and an exact minor can be
    98	pinned once verified.
    99	
   100	Automated backups are 7 days in synthetic staging, taken in an explicit window, with
   101	`delete_automated_backups = false`. They cannot be disabled: the variable rejects zero.
   102	Production retention is set from production recovery objectives, and the production root
   103	refuses to plan until someone states it. After the first backup exists, confirm
   104	`LatestRestorableTime` advances; a restore rehearsal belongs to Step 9, but an
   105	unavailable backup is already a Step 8 failure.
   106	
   107	Removal takes two deliberate changes: deletion protection is on, and
   108	`skip_final_snapshot = false` forces a named final snapshot. `db_final_snapshot_suffix`
   109	exists because AWS still holds the name of a previous teardown's snapshot.
   110	
   111	`rds.force_ssl = 1` makes the server refuse plaintext, which is half the guarantee. The
   112	other half is the client: `db.rs` pins `sslmode=verify-full` against the CA bundle baked
   113	into the image at `/etc/ssl/certs/rds-global-bundle.pem` (`DB_SSL_ROOT_CERT`). Rotating
   114	either side is an operations procedure — pin `db_ca_cert_identifier` after confirming the
   115	CA is available in the region, and refresh the image's bundle and its recorded SHA-256
   116	before the current CA expires. Never relax verification to diagnose a TLS failure.
   117	[RDS PostgreSQL TLS](https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/PostgreSQL.Concepts.General.SSL.html).
   118	
   119	The master credential is RDS-managed in Secrets Manager under the data key, so no
   120	password passes through Terraform or its state. It is a bootstrap credential: S6's
   121	one-shot task uses it to create the schema-owner and runtime logins. Its ARN is a module
   122	output and is deliberately **not** in the foundation manifest — no release needs it.
   123	
   124	## Deliberately not created
   125	
   126	- **No application export bucket.** `note/export` returns text over HTTP; nothing writes
   127	  exports to object storage. Reserve that interface when a consumer is designed.
   128	- **No CloudTrail or log bucket.** Security evidence keeps its own key boundary and
   129	  retention, and belongs to S9, not to audio's lifecycle.
   130	- **No engine log export, Performance Insights, or enhanced monitoring.** Each creates a
   131	  destination with its own retention; S9 owns that decision.
   132	
   133	## Interfaces and later-step obligations
   134	
   135	| Consumer | Interface | Required integration |
   136	|---|---|---|
   137	| S4 network | `audio_bucket_name` composed in the root | Already wired: the same string scopes the S3 gateway endpoint policy |
   138	| S6 identity | `audio_bucket_arn`, `stt_queue_arn`, `stt_dlq_arn`, `db_arn`, `kms_key_arn`, `db_master_user_secret_arn` | Resource-scoped task/execution policies plus matching key-policy grants; `s3:ListBucket` for the API so a missing upload answers 404 rather than 403 |
   139	| S6 database | `db_host`, `db_port`, `db_name`, `db_master_user_secret_arn` | Non-superuser logins, revoked public schema creation, migrations under the owner |
   140	| S8 release | manifest `audio_bucket`, `stt_queue_name`, `db_endpoint`, `db_port`, `db_name` | Task-definition environment; credentials injected from Secrets Manager, never from the manifest |
   141	| S9 telemetry | `stt_queue_url`, `stt_dlq_url`, `db_identifier` | Queue depth/age and DLQ alarms, and log destinations with their own retention |
   142	| Step 9 protocol | — | Version/checksum binding for audio before any PHI use |
   143	
   144	Live checks, costs and pending evidence: [data verification](../../../docs/ops/data-verification.md).
