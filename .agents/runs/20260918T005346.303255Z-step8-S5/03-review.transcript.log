    45	# ---------------------------------------------------------------------------
    46	# The database
    47	# ---------------------------------------------------------------------------
    48	# Single instance, private placement, encrypted storage and backups, deletion protected.
    49	# It holds events, snapshots, audio-chunk transcripts, notes and usage attribution, so
    50	# it is the largest concentration of clinical content in the system even though staging
    51	# is synthetic. Backups and snapshots are separate copies of all of it.
    52	
    53	resource "aws_db_instance" "this" {
    54	  identifier = local.db_identifier
    55	
    56	  engine = "postgres"
    57	  # A bare major version lets RDS choose a currently supported minor at creation time
    58	  # instead of pinning one this repository cannot verify. Check the class and storage
    59	  # combination with `describe-orderable-db-instance-options` before the first apply.
    60	  engine_version              = var.postgres_version
    61	  auto_minor_version_upgrade  = true
    62	  allow_major_version_upgrade = false
    63	  parameter_group_name        = aws_db_parameter_group.postgres.name
    64	
    65	  instance_class        = var.db_instance_class
    66	  storage_type          = "gp3"
    67	  allocated_storage     = var.db_allocated_storage
    68	  max_allocated_storage = var.db_max_allocated_storage
    69	  storage_encrypted     = true
    70	  kms_key_id            = aws_kms_key.data.arn
    71	
    72	  db_name  = var.db_name
    73	  username = var.db_master_username
    74	  # RDS creates and stores the master password in Secrets Manager under the application
    75	  # data key. No password is passed through Terraform, so none is written to state.
    76	  # S6 uses this credential once, from a one-shot task inside the VPC, to create the
    77	  # schema-owner and runtime logins; no running service ever receives it.
    78	  manage_master_user_password   = true
    79	  master_user_secret_kms_key_id = aws_kms_key.data.arn
    80	
    81	  # Private by construction: no public endpoint, isolated subnets with no route to the
    82	  # internet gateway or NAT, and ingress only from the four approved task groups.
    83	  publicly_accessible    = false
    84	  db_subnet_group_name   = var.db_subnet_group_name
    85	  vpc_security_group_ids = var.db_security_group_ids
    86	  multi_az               = var.db_multi_az
    87	  ca_cert_identifier     = var.db_ca_cert_identifier
    88	
    89	  backup_retention_period  = var.db_backup_retention_days
    90	  backup_window            = var.db_backup_window
    91	  maintenance_window       = var.db_maintenance_window
    92	  copy_tags_to_snapshot    = true
    93	  delete_automated_backups = false
    94	
    95	  # Two separate brakes on accidental loss: AWS refuses the delete call while deletion
    96	  # protection is on, and Terraform must name a final snapshot when it is turned off.
    97	  # Teardown is therefore a reviewed apply that changes both, not a stray `destroy`.
    98	  deletion_protection       = var.db_deletion_protection
    99	  skip_final_snapshot       = false
   100	  final_snapshot_identifier = "${local.db_identifier}-final-${var.db_final_snapshot_suffix}"
   101	
   102	  apply_immediately = var.db_apply_immediately
   103	
   104	  # Enhanced monitoring, Performance Insights and engine log export are S9's telemetry
   105	  # decisions: each one creates a new destination with its own retention, and exporting
   106	  # engine logs before S9 sets retention would create an unmanaged copy.
   107	}
     1	# ---------------------------------------------------------------------------
     2	# Audio bucket
     3	# ---------------------------------------------------------------------------
     4	# The device PUTs raw encounter audio straight here with a presigned URL minted by the
     5	# API (`audio_upload_intent` in routes.rs). Keys are UUID-only and org-prefixed —
     6	# `<org>/<patient>/<encounter>/<index>-<chunk>` — so no name, label or filename reaches
     7	# object storage. Nothing else writes to this bucket, and no export bucket exists:
     8	# `note/export` returns its text over HTTP and has no S3 consumer to design for yet.
     9	
    10	resource "aws_s3_bucket" "audio" {
    11	  bucket = var.audio_bucket_name
    12	}
    13	
    14	# Versioning is what makes an overwritten upload recoverable. It is **not** an
    15	# immutability guarantee: a presigned PUT can be replayed against the same key, and the
    16	# current version is whatever landed last. Binding a chunk to one version id or checksum
    17	# at completion is a Step 9 protocol change, tracked in the module README.
    18	resource "aws_s3_bucket_versioning" "audio" {
    19	  bucket = aws_s3_bucket.audio.id
    20	  versioning_configuration {
    21	    status = "Enabled"
    22	  }
    23	}
    24	
    25	# ACLs disabled entirely, so access is decided by bucket and IAM policy alone.
    26	resource "aws_s3_bucket_ownership_controls" "audio" {
    27	  bucket = aws_s3_bucket.audio.id
    28	  rule {
    29	    object_ownership = "BucketOwnerEnforced"
    30	  }
    31	}
    32	
    33	resource "aws_s3_bucket_public_access_block" "audio" {
    34	  bucket                  = aws_s3_bucket.audio.id
    35	  block_public_acls       = true
    36	  block_public_policy     = true
    37	  ignore_public_acls      = true
    38	  restrict_public_buckets = true
    39	}
    40	
    41	resource "aws_s3_bucket_server_side_encryption_configuration" "audio" {
    42	  bucket = aws_s3_bucket.audio.id
    43	  rule {
    44	    apply_server_side_encryption_by_default {
    45	      sse_algorithm     = "aws:kms"
    46	      kms_master_key_id = aws_kms_key.data.arn
    47	    }
    48	    # Bucket keys reuse one data key across objects, which is the difference between one
    49	    # KMS request per upload and one per bucket-key period. The encryption context S3
    50	    # sends changes with bucket keys enabled, so S6's `kms:EncryptionContext` conditions
    51	    # must be tested against a real upload rather than assumed.
    52	    bucket_key_enabled = true
    53	  }
    54	}
    55	
    56	# ---------------------------------------------------------------------------
    57	# Lifecycle
    58	# ---------------------------------------------------------------------------
    59	# Current objects and superseded versions expire on separate clocks, and abandoned
    60	# multipart uploads are swept up. There is deliberately no storage-class transition:
    61	# the worker downloads pending audio with `GetObject` and has no restore workflow, so
    62	# an archived object would fail transcription rather than delay it.
    63	#
    64	# Expiry is asynchronous — S3 removes objects some time after they qualify. It is not a
    65	# deletion deadline, and it erases none of the other copies: the transcript in
    66	# `audio_chunks`, the `TranscriptReady` event, snapshots, exported notes, or backups.
    67	
    68	resource "aws_s3_bucket_lifecycle_configuration" "audio" {
    69	  bucket = aws_s3_bucket.audio.id
    70	
    71	  rule {
    72	    id     = "expire-current-audio"
    73	    status = "Enabled"
    74	    filter {}
    75	
    76	    expiration {
    77	      days = var.audio_retention_days
    78	    }
    79	  }
    80	
    81	  rule {
    82	    id     = "expire-superseded-audio-versions"
    83	    status = "Enabled"
    84	    filter {}
    85	
    86	    noncurrent_version_expiration {
    87	      noncurrent_days = var.audio_noncurrent_version_retention_days
    88	    }
    89	  }
    90	
    91	  rule {
    92	    id     = "abort-incomplete-uploads"
    93	    status = "Enabled"
    94	    filter {}
    95	
    96	    abort_incomplete_multipart_upload {
    97	      days_after_initiation = var.audio_abort_incomplete_multipart_days
    98	    }
    99	  }
   100	
   101	  depends_on = [aws_s3_bucket_versioning.audio]
   102	}
   103	
   104	# ---------------------------------------------------------------------------
   105	# Bucket policy
   106	# ---------------------------------------------------------------------------
   107	# A bucket policy binds every caller, including an account administrator and including
   108	# Terraform. It is the floor no IAM policy can raise.
   109	
   110	locals {
   111	  # Zero or one element: a tuple the optional statement is projected from, so the policy
   112	  # stays one expression instead of a conditional whose branches have different types.
   113	  bucket_administration_lists = length(var.bucket_administration_principal_arns) == 0 ? [] : [sort(tolist(var.bucket_administration_principal_arns))]
   114	
   115	  audio_bucket_statements = concat([
   116	    {
   117	      Sid       = "DenyInsecureTransport"
   118	      Effect    = "Deny"
   119	      Principal = "*"
   120	      Action    = "s3:*"
   121	      Resource  = [local.audio_bucket_arn, "${local.audio_bucket_arn}/*"]
   122	      Condition = { Bool = { "aws:SecureTransport" = "false" } }
   123	    },
   124	    {
   125	      Sid       = "DenyOutdatedTls"
   126	      Effect    = "Deny"
   127	      Principal = "*"
   128	      Action    = "s3:*"
   129	      Resource  = [local.audio_bucket_arn, "${local.audio_bucket_arn}/*"]
   130	      Condition = { NumericLessThan = { "s3:TlsVersion" = "1.2" } }
   131	    },
   132	    # The presigned PUT the device performs carries a signature and a Content-Type and
   133	    # no encryption headers at all, and the bucket default encrypts it correctly. These
   134	    # two statements stop a caller from *overriding* that default with SSE-S3 or with a
   135	    # different key. `StringNotEqualsIfExists` is load-bearing: absent header, allowed;
   136	    # present and wrong, denied. Requiring the headers instead would break every
   137	    # currently minted URL and would need the presign contract and client changed first.
   138	    {
   139	      Sid       = "DenyWrongEncryptionAlgorithm"
   140	      Effect    = "Deny"
   141	      Principal = "*"
   142	      Action    = "s3:PutObject"
   143	      Resource  = "${local.audio_bucket_arn}/*"
   144	      Condition = { StringNotEqualsIfExists = { "s3:x-amz-server-side-encryption" = "aws:kms" } }
   145	    },
   146	    {
   147	      Sid       = "DenyWrongEncryptionKey"
   148	      Effect    = "Deny"
   149	      Principal = "*"
   150	      Action    = "s3:PutObject"
   151	      Resource  = "${local.audio_bucket_arn}/*"
   152	      Condition = { StringNotEqualsIfExists = { "s3:x-amz-server-side-encryption-aws-kms-key-id" = aws_kms_key.data.arn } }
   153	    }],
   154	    # Opt-in: pin the bucket's own controls to named principals. Runtime roles are kept
   155	    # away from these actions by their S6 policies; this statement is the second layer,
   156	    # and it is empty by default because locking a bucket to the wrong ARN list is its
   157	    # own kind of outage. `aws:PrincipalArn` reports the role ARN for an assumed role,
   158	    # so list role ARNs here, not STS session ARNs. There is no `aws:SourceVpce`
   159	    # condition anywhere in this policy: the phone and CLI sign uploads from outside
   160	    # the VPC, and a VPC-only deny would break every one of those uploads.
   161	    [for principals in local.bucket_administration_lists : {
   162	      Sid       = "DenyProtectionChangesOutsideAdministration"
   163	      Effect    = "Deny"
   164	      Principal = "*"
   165	      Action = [
   166	        "s3:DeleteBucket",
   167	        "s3:PutBucketPolicy",
   168	        "s3:DeleteBucketPolicy",
   169	        "s3:PutBucketVersioning",
   170	        "s3:PutLifecycleConfiguration",
   171	        "s3:PutEncryptionConfiguration",
   172	        "s3:PutBucketPublicAccessBlock",
   173	        "s3:PutBucketOwnershipControls",
   174	        "s3:PutBucketAcl",
   175	      ]
   176	      Resource  = local.audio_bucket_arn
   177	      Condition = { StringNotLike = { "aws:PrincipalArn" = principals } }
   178	  }])
   179	}
   180	
   181	resource "aws_s3_bucket_policy" "audio" {
   182	  bucket = aws_s3_bucket.audio.id
   183	  policy = jsonencode({
   184	    Version   = "2012-10-17"
   185	    Statement = local.audio_bucket_statements
   186	  })
   187	
   188	  # A public-access block must exist before a policy is evaluated against it, or the
   189	  # apply can race and fail on a fresh bucket.
   190	  depends_on = [aws_s3_bucket_public_access_block.audio]
   191	}
     1	# ---------------------------------------------------------------------------
     2	# Job queue and dead-letter queue
     3	# ---------------------------------------------------------------------------
     4	# One **standard** queue carries both job kinds the application sends — the
     5	# `TranscribeChunk` the API enqueues at upload completion and the `GenerateMdm` it
     6	# enqueues on request (`queue.rs`). A second queue would be a measured latency decision,
     7	# not a requirement of the code that exists.
     8	#
     9	# The names are load-bearing. The application is configured with `STT_QUEUE=<name>` and
    10	# derives its dead-letter queue as `<name>-dlq` (`Config::stt_dlq`), then resolves both
    11	# with `GetQueueUrl` rather than creating anything. Renaming either queue without
    12	# renaming the other breaks worker startup.
    13	#
    14	# Message bodies are opaque identifiers by construction (§C5): audio lives in S3,
    15	# transcripts live in Postgres, and neither passes through a message body, an attribute,
    16	# a queue name or an alarm.
    17	
    18	resource "aws_sqs_queue" "dlq" {
    19	  name = local.dlq_name
    20	
    21	  # Failed work must stay inspectable for longer than the main queue holds live work.
    22	  message_retention_seconds = var.dlq_retention_days * 24 * 60 * 60
    23	
    24	  # Naming a customer-managed key replaces SQS-managed encryption; the provider rejects
    25	  # setting both, so `sqs_managed_sse_enabled` is deliberately absent rather than false.
    26	  # Producers and consumers therefore need KMS permissions of their own, which S6 grants.
    27	  kms_master_key_id                 = aws_kms_key.data.arn
    28	  kms_data_key_reuse_period_seconds = 300
    29	
    30	  # Only the main queue may deposit here. This is about the *source queue*, not about
    31	  # who may move messages back: that is an IAM grant on `sqs:StartMessageMoveTask`,
    32	  # optionally mirrored by the operator statement in the queue policy below.
    33	  redrive_allow_policy = jsonencode({
    34	    redrivePermission = "byQueue"
    35	    sourceQueueArns   = [local.queue_arn]
    36	  })
    37	}
    38	
    39	resource "aws_sqs_queue" "jobs" {
    40	  name = local.queue_name
    41	
    42	  # 300 seconds matches the worker's lease exactly (S1 `WorkerLimits`). The worker also
    43	  # heartbeats visibility while it holds a message; a shorter queue-side timeout would
    44	  # hand the same job to a second worker while the first is still transcribing.
    45	  visibility_timeout_seconds = var.queue_visibility_timeout_seconds
    46	  receive_wait_time_seconds  = var.queue_receive_wait_seconds
    47	  message_retention_seconds  = var.queue_retention_days * 24 * 60 * 60
    48	
    49	  kms_master_key_id                 = aws_kms_key.data.arn
    50	  kms_data_key_reuse_period_seconds = 300
    51	
    52	  redrive_policy = jsonencode({
    53	    deadLetterTargetArn = local.dlq_arn
    54	    maxReceiveCount     = var.queue_max_receive_count
    55	  })
    56	
    57	  # The ARN is composed from inputs above rather than read from the DLQ resource, but
    58	  # the DLQ must still exist before a job can be redriven to it.
    59	  depends_on = [aws_sqs_queue.dlq]
    60	}
    61	
    62	# ---------------------------------------------------------------------------
    63	# Queue policies
    64	# ---------------------------------------------------------------------------
    65	# Resource policies here are a floor, like the bucket policy. The producing and
    66	# consuming grants themselves are IAM policies written in S6, scoped to these ARNs.
    67	
    68	locals {
    69	  insecure_transport_statement = {
    70	    for key, arn in { jobs = local.queue_arn, dlq = local.dlq_arn } :
    71	    key => {
    72	      Sid       = "DenyInsecureTransport"
    73	      Effect    = "Deny"
    74	      Principal = "*"
    75	      Action    = "sqs:*"
    76	      Resource  = arn
    77	      Condition = { Bool = { "aws:SecureTransport" = "false" } }
    78	    }
    79	  }
    80	
    81	  # Zero or one element, for the same reason as the bucket policy's optional statement.
    82	  dlq_operator_lists = length(var.dlq_operator_principal_arns) == 0 ? [] : [sort(tolist(var.dlq_operator_principal_arns))]
    83	
    84	  dlq_operator_statements = [
    85	    for principals in local.dlq_operator_lists : {
    86	      Sid       = "AllowOperatorRedrive"
    87	      Effect    = "Allow"
    88	      Principal = { AWS = principals }
    89	      Action = [
    90	        "sqs:GetQueueAttributes",
    91	        "sqs:GetQueueUrl",
    92	        "sqs:ReceiveMessage",
    93	        "sqs:DeleteMessage",
    94	        "sqs:StartMessageMoveTask",
    95	        "sqs:ListMessageMoveTasks",
    96	        "sqs:CancelMessageMoveTask",
    97	      ]
    98	      Resource  = local.dlq_arn
    99	      Condition = { Bool = { "aws:SecureTransport" = "true" } }
   100	    }
   101	  ]
   102	}
   103	
   104	resource "aws_sqs_queue_policy" "jobs" {
   105	  queue_url = aws_sqs_queue.jobs.url
   106	  policy = jsonencode({
   107	    Version   = "2012-10-17"
   108	    Statement = [local.insecure_transport_statement["jobs"]]
   109	  })
   110	}
   111	
   112	resource "aws_sqs_queue_policy" "dlq" {
   113	  queue_url = aws_sqs_queue.dlq.url
   114	  policy = jsonencode({
   115	    Version   = "2012-10-17"
   116	    Statement = concat([local.insecure_transport_statement["dlq"]], local.dlq_operator_statements)
   117	  })
   118	}

