    27	cp "${repo_root}/infra/envs/staging/foundation/.terraform.lock.hcl" "${work}/infra/modules/data/"
    28	
    29	for relative in modules/data envs/staging/foundation envs/prod/foundation; do
    30	  test_dir="${work}/infra/${relative}"
    31	  # A local filesystem provider mirror is optional; the lock still verifies it.
    32	  init_args=()
    33	  if [[ -n "${TF_DATA_PLUGIN_DIR:-}" ]]; then
    34	    init_args+=("-plugin-dir=${TF_DATA_PLUGIN_DIR}")
    35	  fi
    36	  terraform -chdir="${test_dir}" init -backend=false -input=false -lockfile=readonly -no-color "${init_args[@]}" >"${work}/init.log" 2>&1 || {
    37	    cat "${work}/init.log"
    38	    exit 1
    39	  }
    40	  terraform -chdir="${test_dir}" validate -no-color
    41	  terraform -chdir="${test_dir}" test -no-color
    42	done

