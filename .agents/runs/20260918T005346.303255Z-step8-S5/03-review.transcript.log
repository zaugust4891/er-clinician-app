   168	        jsondecode(policy.policy).Statement[0].Effect == "Deny" &&
   169	        jsondecode(policy.policy).Statement[0].Condition.Bool["aws:SecureTransport"] == "false"
   170	    ]))
   171	    error_message = "Both queues need SSE-KMS under the data key and must deny insecure transport."
   172	  }
   173	  assert {
   174	    condition     = length(jsondecode(aws_sqs_queue_policy.dlq.policy).Statement) == 1
   175	    error_message = "No operator principals were supplied, so the DLQ policy must grant nobody anything."
   176	  }
