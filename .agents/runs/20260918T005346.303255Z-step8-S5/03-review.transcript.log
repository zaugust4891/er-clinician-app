    61	variable "data" {
    62	  description = <<-EOT
    63	    S5 durable resources. The defaults are S0's synthetic-staging decisions: a single-AZ
    64	    db.t4g.small on 50 GiB gp3, 7-day automated backups, 7-day audio expiry, and a
