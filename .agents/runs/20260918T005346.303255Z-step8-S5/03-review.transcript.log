     1	locals {
     2	  # The environment is a committed constant, not an input. A root cannot be pointed at
     3	  # the wrong environment by passing a different variable, and the release root checks
     4	  # that the manifest it reads carries the environment it expects.
     5	  environment  = "staging"
     6	  manifest_key = "envs/staging/foundation-manifest.json"
     7	
     8	  # S3 bucket names are global, so this one carries the account and region to stay
     9	  # unique — and nothing else: no clinician, patient, or hospital identifier. It is
    10	  # composed here rather than inside the data module because the network module needs
    11	  # the same string for its S3 gateway endpoint policy. Passing one computed name into
    12	  # both modules keeps the dependency one-way (network -> data) instead of circular.
    13	  audio_bucket_name = "${var.project}-${local.environment}-audio-${var.aws_account_id}-${var.aws_region}"
    14	  audio_bucket_arn  = "arn:aws:s3:::${local.audio_bucket_name}"
    15	
    16	  # ---------------------------------------------------------------------------
    17	  # The foundation manifest's payload
    18	  # ---------------------------------------------------------------------------
    19	  # Step 8 S3 establishes this contract; S4-S9 fill it in as each component lands.
    20	  # Keys expected by the end of Step 8, in the order they arrive:
    21	  #
    22	  #   S4  vpc_id, private_subnet_ids, api_security_group_id, worker_security_group_id
    23	  #   S5  audio_bucket, stt_queue_name, stt_queue_url, stt_dlq_url, db_endpoint,
    24	  #       db_port, db_name, data_kms_key_arn
    25	  #   S6  api_task_role_arn, worker_task_role_arn, api_execution_role_arn,
    26	  #       worker_execution_role_arn, migration_task_role_arn,
    27	  #       migration_execution_role_arn
    28	  #   S7  cognito_pool_id, cognito_client_id, cognito_region
    29	  #   S8  ecr_repository_url, ecs_cluster_arn, api_target_group_arn
    30	  #   S9  api_log_group, worker_log_group, migration_log_group, alarm_topic_arn
    31	  #
    32	  # Secrets Manager ARNs belong in manifest_secret_refs. Secret values belong in
    33	  # neither, and the module rejects them.
    34	  # The v1 manifest is map(string): subnet lists are JSON arrays encoded as strings.
    35	  # Release decodes private_subnet_ids with jsondecode, never split on commas.
    36	  manifest_resources = merge({
    37	    deploy_artifacts_bucket = var.deploy_artifacts_bucket
    38	    }, {
    39	    vpc_id                       = module.network[0].vpc_id
    40	    private_subnet_ids           = jsonencode(module.network[0].private_subnet_ids)
    41	    api_security_group_id        = module.network[0].security_group_ids.api
    42	    worker_security_group_id     = module.network[0].security_group_ids.worker
    43	    migration_security_group_id  = module.network[0].security_group_ids.migration
    44	    onboarding_security_group_id = module.network[0].security_group_ids.onboarding
    45	    api_https_port               = tostring(module.network[0].api_https_port)
    46	
    47	    # S5. `audio_bucket` and `stt_queue_name` are the literal values of the API's and
    48	    # worker's AUDIO_BUCKET and STT_QUEUE; the queue URLs are published for operators
    49	    # and S9 alarms, since the application resolves its own URLs with GetQueueUrl.
    50	    # `db_endpoint` is a hostname with no port, because `db.rs` verifies that hostname
    51	    # against the server certificate and composes the port separately.
    52	    # The database login, its password, and the RDS-managed master secret ARN are
    53	    # deliberately absent: S6 owns those, and no release needs them.
    54	    audio_bucket     = module.data[0].audio_bucket_name
    55	    stt_queue_name   = module.data[0].stt_queue_name
    56	    stt_queue_url    = module.data[0].stt_queue_url
    57	    stt_dlq_url      = module.data[0].stt_dlq_url
    58	    db_endpoint      = module.data[0].db_host
    59	    db_port          = tostring(module.data[0].db_port)
    60	    db_name          = module.data[0].db_name
    61	    data_kms_key_arn = module.data[0].kms_key_arn
    62	  })
    63	
    64	  manifest_secret_refs = {}
    65	
    66	  # Staging always publishes its manifest.
    67	  manifest_enabled = true
    68	}
