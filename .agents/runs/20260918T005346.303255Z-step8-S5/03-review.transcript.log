     9	# policy, that the manifest publishes the S5 keys, and that production stays disabled.
    10	set -euo pipefail
    11	repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    12	work="$(mktemp -d)"
    13	trap 'rm -rf "${work}"' EXIT
    14	
    15	for relative in modules/data modules/network modules/manifest envs/staging/foundation envs/prod/foundation; do
    16	  source_dir="${repo_root}/infra/${relative}"
    17	  test_dir="${work}/infra/${relative}"
