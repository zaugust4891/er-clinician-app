     1	# S5 durable resources: the encrypted database, the audio bucket, and the job queue
     2	# pair the application already expects. Placement comes from S4; IAM grants, database
     3	# logins and secret values come from S6.
     4	
     5	module "data" {
     6	  source = "../../../modules/data"
